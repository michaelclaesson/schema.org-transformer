TYPESENSE_HOST=
TYPESENSE_PORT=443
TYPESENSE_PROTOCOL=https
TYPESENSE_API_KEY=replace-me

WP_EVENTS_API_URL='https://event.eslov.dev/wp-json/wp/v2/events?per_page=100&_embed=true'

# Optional. Only sent if both are set. Needed when the host above sits
# behind HTTP Basic Auth (htpasswd), as event.eslov.dev does.
WP_EVENTS_API_USER=
WP_EVENTS_API_PASSWORD=

WP_LEGACY_EVENTS_API_URL='https://api.helsingborg.se/event/json/wp/v2/event/time?start=2026-06-22&end=2027-06-10&group-id=4260&per_page=100'

# Optional. 'get-param' (default) paginates by incrementing ?page=,
# independent of response headers. 'wordpress' is the original
# behavior: it follows the Link response header's rel="next" URL, which
# the legacy endpoint above does not send, so pagination stops after the
# first page.
WP_LEGACY_EVENTS_PAGINATOR=
